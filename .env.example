# Mazikor Schools — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database ---
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mazikor?schema=public"

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Canonical URL of the deployment. Legacy alias: NEXTAUTH_URL
AUTH_URL="http://localhost:3000"
# Set to true when running behind a proxy (Vercel, Docker, etc.)
AUTH_TRUST_HOST="true"

# --- Public (inlined into the client bundle at build time) ---
NEXT_PUBLIC_APP_NAME="Mazikor Schools"
NEXT_PUBLIC_APP_TAGLINE="Smart School Management, Made Simple."
# Public site URL used for metadataBase, sitemap and robots.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Fallback alias for the site URL (kept for backwards compatibility).
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Demo mode ---
# Set to "true" ONLY on demo deployments to show quick-fill buttons on the
# login page. Never enable in production.
NEXT_PUBLIC_DEMO_MODE="false"

# --- Billing (optional, reserved for a future payment provider) ---
# When unset, subscriptions are managed manually by platform administrators.
# BILLING_PROVIDER=""
