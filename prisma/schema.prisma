// Mazikor Schools — Prisma schema
// "Smart School Management, Made Simple."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANCY / SUBSCRIPTION
// ============================================================

model School {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  slug               String   @unique
  logo               String?
  address            String?
  phone              String?
  email              String?
  website            String?
  registrationNumber String?
  motto              String?
  currency           String   @default("MWK")
  currencySymbol     String   @default("MK")
  primaryColor       String   @default("#1d4ed8")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  academicYears         AcademicYear[]
  terms                 Term[]
  students              Student[]
  parents               Parent[]
  teachers              Teacher[]
  staff                 Staff[]
  employees             Employee[]
  classes               Class[]
  subjects              Subject[]
  departments           Department[]
  enrollments           Enrollment[]
  attendance            Attendance[]
  exams                 Exam[]
  examSubjects          ExamSubject[]
  results               Result[]
  gradeScales           GradeScale[]
  feeStructures         FeeStructure[]
  invoices              Invoice[]
  payments              Payment[]
  expenses              Expense[]
  timetable             TimetableEntry[]
  assignments           Assignment[]
  notices               Notice[]
  events                Event[]
  books                 Book[]
  bookLoans             BookLoan[]
  vehicles              Vehicle[]
  routes                Route[]
  inventoryItems        InventoryItem[]
  documents             Document[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  subscription          Subscription?
  leaveRequests         Leave[]
  streams               Stream[]
  classSubjects         ClassSubject[]
  subjectTeachers       SubjectTeacher[]
  studentNotes          StudentNote[]
  studentParents        StudentParent[]
  staffAttendances      StaffAttendance[]
  invoiceItems          InvoiceItem[]
  assignmentSubmissions AssignmentSubmission[]
  payrolls              Payroll[]

  @@index([code])
  @@map("school")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  priceMonthly Decimal  @default(0)
  priceYearly  Decimal  @default(0)
  currency     String   @default("MWK")
  maxStudents  Int      @default(100)
  maxTeachers  Int      @default(10)
  maxStaff     Int      @default(10)
  maxAdmins    Int      @default(1)
  maxStorageGB Int      @default(5)
  features     Json?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plan")
}

model Subscription {
  id           String    @id @default(cuid())
  schoolId     String    @unique
  planId       String
  status       SubStatus @default(TRIAL)
  startDate    DateTime  @default(now())
  renewalDate  DateTime?
  trialEndsAt  DateTime?
  customLimits Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@map("subscription")
}

enum SubStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

// ============================================================
// USERS, ROLES, PERMISSIONS
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  avatar        String?
  roleId        String
  schoolId      String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role           Role                   @relation(fields: [roleId], references: [id])
  school         School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  student        Student?
  teacher        Teacher?
  parent         Parent?
  staff          Staff?
  employee       Employee?
  documents      Document[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  leavesApproved Leave[]                @relation("LeaveApprover")
  paychecks      Payroll[]
  submissions    AssignmentSubmission[]

  @@index([schoolId])
  @@index([roleId])
  @@map("user")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  key         String
  description String?
  isSystem    Boolean  @default(false)
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([key, schoolId])
  @@map("role")
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permission")
}

// ============================================================
// ACADEMIC STRUCTURE
// ============================================================

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms    Term[]
  exams    Exam[]
  invoices Invoice[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_year")
}

model Term {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams         Exam[]
  invoices      Invoice[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, academicYearId, name])
  @@index([academicYearId])
  @@map("term")
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  level     Int      @default(1)
  capacity  Int      @default(40)
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  streams         Stream[]
  subjects        ClassSubject[]
  enrollments     Enrollment[]
  timetables      TimetableEntry[]
  classTeacherId  String?
  classTeacher    Teacher?         @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  subjectTeachers SubjectTeacher[]
  examSubjects    ExamSubject[]
  feeStructures   FeeStructure[]
  assignments     Assignment[]
  notices         Notice[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("class")
}

model Stream {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  createdAt DateTime @default(now())

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  timetables  TimetableEntry[]
  students    Student[]
  attendance  Attendance[]

  @@unique([classId, name])
  @@index([classId])
  @@map("stream")
}

model Department {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  employees Employee[]

  @@unique([schoolId, name])
  @@map("department")
}

model Subject {
  id           String   @id @default(cuid())
  schoolId     String
  code         String
  name         String
  description  String?
  departmentId String?
  passMark     Decimal  @default(40)
  maxMark      Decimal  @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  classLinks   ClassSubject[]
  teacherLinks SubjectTeacher[]
  exams        ExamSubject[]
  timetables   TimetableEntry[]
  assignments  Assignment[]
  attendances  Attendance[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subject")
}

model ClassSubject {
  id        String @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@map("class_subject")
}

model SubjectTeacher {
  id        String @id @default(cuid())
  schoolId  String
  teacherId String
  subjectId String
  classId   String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@map("subject_teacher")
}

// ============================================================
// PEOPLE
// ============================================================

model Student {
  id              String        @id @default(cuid())
  schoolId        String
  admissionNumber String        @unique
  userId          String?       @unique
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender
  dateOfBirth     DateTime?
  nationality     String        @default("Malawian")
  address         String?
  phone           String?
  email           String?
  photo           String?
  admissionDate   DateTime      @default(now())
  streamId        String?
  house           String?
  previousSchool  String?
  medicalNotes    String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  stream      Stream?                @relation(fields: [streamId], references: [id], onDelete: SetNull)
  parents     StudentParent[]
  enrollments Enrollment[]
  attendance  Attendance[]
  results     Result[]
  invoices    Invoice[]
  payments    Payment[]
  bookLoans   BookLoan[]
  assignments AssignmentSubmission[]
  documents   Document[]
  notes       StudentNote[]

  @@index([schoolId])
  @@index([streamId])
  @@index([status])
  @@map("student")
}

model StudentNote {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_note")
}

model Parent {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String?  @unique
  firstName    String
  lastName     String
  phone        String
  email        String?
  address      String?
  occupation   String?
  relationship String
  isEmergency  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentParent[]

  @@index([schoolId])
  @@map("parent")
}

model StudentParent {
  id        String @id @default(cuid())
  schoolId  String
  studentId String
  parentId  String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parent")
}

model Enrollment {
  id         String        @id @default(cuid())
  schoolId   String
  studentId  String
  classId    String
  streamId   String?
  termId     String?
  status     StudentStatus @default(ACTIVE)
  enrolledAt DateTime      @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream  Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  term    Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([classId])
  @@map("enrollment")
}

model Teacher {
  id             String         @id @default(cuid())
  schoolId       String
  employeeId     String         @unique
  userId         String?        @unique
  firstName      String
  lastName       String
  gender         Gender
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  qualification  String?
  specialization String?
  joiningDate    DateTime?
  employmentType EmploymentType @default(FULL_TIME)
  salary         Decimal?       @default(0)
  status         TeacherStatus  @default(ACTIVE)
  photo          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjects       SubjectTeacher[]
  classTeacher   Class[]           @relation("ClassTeacher")
  timetables     TimetableEntry[]
  attendance     StaffAttendance[]
  assignments    Assignment[]
  payroll        Payroll[]
  leaves         Leave[]
  resultsEntered Result[]

  @@index([schoolId])
  @@map("teacher")
}

model Staff {
  id             String         @id @default(cuid())
  schoolId       String
  employeeId     String         @unique
  userId         String?        @unique
  firstName      String
  lastName       String
  gender         Gender
  phone          String?
  email          String?
  address        String?
  position       String?
  department     String?
  joiningDate    DateTime?
  employmentType EmploymentType @default(FULL_TIME)
  salary         Decimal?       @default(0)
  status         TeacherStatus  @default(ACTIVE)
  photo          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance StaffAttendance[]
  payroll    Payroll[]
  leaves     Leave[]

  @@index([schoolId])
  @@map("staff")
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  WITHDRAWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  streamId   String?
  classId    String
  date       DateTime
  status     AttendanceStatus
  subjectId  String?
  markedById String
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stream  Stream?  @relation(fields: [streamId], references: [id], onDelete: SetNull)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([studentId, date, subjectId])
  @@index([schoolId, date])
  @@index([classId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model StaffAttendance {
  id        String           @id @default(cuid())
  schoolId  String
  teacherId String?
  staffId   String?
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("staff_attendance")
}

// ============================================================
// EXAMINATIONS / RESULTS / GRADING
// ============================================================

model GradeScale {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bands  GradeBand[]
  exams  Exam[]

  @@unique([schoolId, name])
  @@map("grade_scale")
}

model GradeBand {
  id           String  @id @default(cuid())
  gradeScaleId String
  min          Decimal
  max          Decimal
  grade        String
  points       Decimal @default(0)
  remark       String?

  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@index([gradeScaleId])
  @@map("grade_band")
}

model Exam {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  type           ExamType
  academicYearId String
  termId         String
  gradeScaleId   String?
  startDate      DateTime
  endDate        DateTime
  description    String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  gradeScale   GradeScale?   @relation(fields: [gradeScaleId], references: [id], onDelete: SetNull)
  subjects     ExamSubject[]
  results      Result[]

  @@index([schoolId])
  @@map("exam")
}

enum ExamType {
  TEST
  MID_TERM
  END_OF_TERM
  MOCK
  FINAL
}

model ExamSubject {
  id        String    @id @default(cuid())
  schoolId  String
  examId    String
  subjectId String
  classId   String
  date      DateTime?
  maxMark   Decimal   @default(100)
  passMark  Decimal   @default(40)
  weight    Decimal   @default(1)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  results Result[]

  @@unique([examId, subjectId, classId])
  @@index([examId])
  @@map("exam_subject")
}

model Result {
  id            String   @id @default(cuid())
  schoolId      String
  examId        String
  examSubjectId String
  studentId     String
  rawMark       Decimal
  percentage    Decimal
  grade         String?
  points        Decimal  @default(0)
  position      Int?
  comment       String?
  enteredById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy   Teacher     @relation(fields: [enteredById], references: [id], onDelete: Restrict)

  @@unique([examSubjectId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("result")
}

// ============================================================
// FINANCE
// ============================================================

model FeeStructure {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  category   String
  amount     Decimal
  classId    String?
  termId     String?
  isRequired Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  term   Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  items  InvoiceItem[]

  @@index([schoolId])
  @@map("fee_structure")
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  number         String        @unique
  studentId      String
  termId         String?
  academicYearId String?
  dueDate        DateTime?
  discount       Decimal       @default(0)
  notes          String?
  status         InvoiceStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([schoolId, number])
  @@index([studentId])
  @@map("invoice")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  schoolId       String
  invoiceId      String
  feeStructureId String?
  description    String
  amount         Decimal
  createdAt      DateTime @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_item")
}

model Payment {
  id            String        @id @default(cuid())
  schoolId      String
  receiptNumber String        @unique
  invoiceId     String
  studentId     String
  amount        Decimal
  method        PaymentMethod
  date          DateTime      @default(now())
  reference     String?
  receivedById  String?
  notes         String?
  createdAt     DateTime      @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, receiptNumber])
  @@index([invoiceId])
  @@index([studentId])
  @@map("payment")
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  CHEQUE
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  schoolId    String
  number      String          @unique
  category    ExpenseCategory
  description String
  amount      Decimal
  date        DateTime        @default(now())
  vendor      String?
  method      PaymentMethod?
  receiptUrl  String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@map("expense")
}

enum ExpenseCategory {
  SALARIES
  UTILITIES
  MAINTENANCE
  SUPPLIES
  TRANSPORT
  FOOD
  OTHER
}

// ============================================================
// TIMETABLE / ASSIGNMENTS / NOTICES / EVENTS
// ============================================================

model TimetableEntry {
  id        String   @id @default(cuid())
  schoolId  String
  streamId  String?
  classId   String
  teacherId String
  subjectId String
  dayOfWeek Int
  period    Int
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream  Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([streamId, dayOfWeek, period])
  @@index([teacherId, dayOfWeek])
  @@map("timetable_entry")
}

model Assignment {
  id            String   @id @default(cuid())
  schoolId      String
  title         String
  description   String?
  instructions  String?
  subjectId     String
  classId       String
  teacherId     String
  dueDate       DateTime
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([classId])
  @@index([teacherId])
  @@map("assignment")
}

model AssignmentSubmission {
  id            String   @id @default(cuid())
  schoolId      String
  assignmentId  String
  studentId     String
  content       String?
  attachmentUrl String?
  grade         Decimal?
  feedback      String?
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@map("assignment_submission")
}

model Notice {
  id            String         @id @default(cuid())
  schoolId      String
  title         String
  content       String
  audience      NoticeAudience
  classId       String?
  publishDate   DateTime       @default(now())
  expiryDate    DateTime?
  attachmentUrl String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId, publishDate])
  @@map("notice")
}

enum NoticeAudience {
  EVERYONE
  TEACHERS
  STUDENTS
  PARENTS
  CLASS
}

model Event {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  description String?
  type        String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  color       String?
  createdById String
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
  @@map("event")
}

// ============================================================
// LIBRARY / TRANSPORT / INVENTORY
// ============================================================

model Book {
  id        String   @id @default(cuid())
  schoolId  String
  isbn      String?
  title     String
  author    String?
  category  String?
  publisher String?
  year      Int?
  quantity  Int      @default(1)
  available Int      @default(1)
  shelf     String?
  createdAt DateTime @default(now())

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loans  BookLoan[]

  @@index([schoolId])
  @@map("book")
}

model BookLoan {
  id         String         @id @default(cuid())
  schoolId   String
  bookId     String
  studentId  String
  borrowDate DateTime       @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     BookLoanStatus @default(BORROWED)
  notes      String?
  createdAt  DateTime       @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("book_loan")
}

enum BookLoanStatus {
  BORROWED
  RETURNED
  OVERDUE
}

model Vehicle {
  id           String   @id @default(cuid())
  schoolId     String
  registration String
  type         String?
  capacity     Int      @default(30)
  driverName   String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routes Route[]

  @@index([schoolId])
  @@map("vehicle")
}

model Route {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  pickupPoints Json?
  vehicleId    String?
  driverName   String?
  capacity     Int      @default(30)
  studentIds   Json?
  createdAt    DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@map("route")
}

model InventoryItem {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  category     String
  quantity     Int       @default(0)
  location     String?
  condition    String    @default("GOOD")
  purchaseDate DateTime?
  value        Decimal   @default(0)
  notes        String?
  createdAt    DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("inventory_item")
}

// ============================================================
// HR / LEAVE / PAYROLL
// ============================================================

model Employee {
  id           String        @id @default(cuid())
  schoolId     String
  userId       String?       @unique
  firstName    String
  lastName     String
  gender       Gender
  email        String?
  phone        String?
  position     String?
  departmentId String?
  salary       Decimal?      @default(0)
  joiningDate  DateTime?
  status       TeacherStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaves     Leave[]
  payrolls   Payroll[]

  @@index([schoolId])
  @@map("employee")
}

model Leave {
  id           String      @id @default(cuid())
  schoolId     String
  employeeId   String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver  User?    @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId String?
  staff     Staff?   @relation(fields: [staffId], references: [id])
  staffId   String?

  @@index([schoolId])
  @@map("leave")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payroll {
  id            String        @id @default(cuid())
  schoolId      String
  employeeId    String
  periodStart   DateTime
  periodEnd     DateTime
  basicSalary   Decimal
  allowances    Json          @default("{}")
  deductions    Json          @default("{}")
  netSalary     Decimal
  status        PayrollStatus @default(DRAFT)
  paidDate      DateTime?
  processedById String?
  notes         String?
  createdAt     DateTime      @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  processed User?    @relation(fields: [processedById], references: [id], onDelete: SetNull)
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId String?
  staff     Staff?   @relation(fields: [staffId], references: [id])
  staffId   String?

  @@unique([schoolId, employeeId, periodStart])
  @@index([schoolId])
  @@map("payroll")
}

enum PayrollStatus {
  DRAFT
  PAID
  CANCELLED
}

// ============================================================
// DOCUMENTS / NOTIFICATIONS / AUDIT
// ============================================================

model Document {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String?
  entityType   String
  entityId     String
  name         String
  fileType     String
  url          String
  size         Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  student   Student? @relation(fields: [studentId], references: [id])
  studentId String?

  @@index([schoolId, entityType, entityId])
  @@map("document")
}

model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  title     String
  body      String?
  type      String    @default("INFO")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId])
  @@map("audit_log")
}
